# =========================================
# Validade Certa — .gitignore
# =========================================

# ---------- Segredos e variáveis de ambiente ----------
.env
.env.*
!.env.example
appsettings.*.local.json
appsettings.Local.json
secrets.json
*.pfx
*.p12
*.key
*.pem

# ---------- Build do .NET ----------
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
[Pp]ublish/
out/
artifacts/
*.nupkg
*.snupkg
project.lock.json
project.fragment.lock.json

# ---------- Pacotes NuGet ----------
*.nuget.props
*.nuget.targets
.nuget/packages/
packages/

# ---------- Testes e cobertura ----------
[Tt]est[Rr]esult*/
TestResults/
coverage/
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
coverage*.info
*.trx

# ---------- Visual Studio ----------
.vs/
*.user
*.userosscache
*.suo
*.sln.docstates
*.rsuser
_ReSharper*/
*.DotSettings.user

# ---------- JetBrains Rider ----------
.idea/
*.sln.iml

# ---------- VS Code ----------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
.history/

# ---------- Docker ----------
docker-compose.override.yml
docker/db/data/

# ---------- Banco de dados local ----------
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.bak
*.dump

# ---------- Uploads e arquivos gerados em desenvolvimento ----------
wwwroot/uploads/
**/wwwroot/uploads/
scripts/criar-tarefas-github.sh

# ---------- Front-end (se usar ferramentas Node no futuro) ----------
node_modules/
npm-debug.log*
yarn-error.log*
.npm/

# ---------- Logs ----------
logs/
*.log

# ---------- Sistema operacional ----------
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*~

# ---------- Temporários ----------
*.tmp
*.temp
*.swp
*.orig
